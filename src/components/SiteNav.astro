---
const { current = "" } = Astro.props;
const links = [
  { href: "/#album", label: "13 Channels" },
  { href: "/#music", label: "Music" },
  { href: "/store/", label: "Store" },
  { href: "/#shows", label: "Shows" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---
<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/" aria-label="Matt Kindle — home"><img src="/images/matt-kindle-logo-warm-v2.png" alt="Matt Kindle" /></a>
    <div class="site-nav__links">
      {links.map(({ href, label }) => <a href={href} aria-current={current === "store" && label === "Store" ? "page" : undefined}>{label}</a>)}
    </div>
    <details class="site-nav__menu">
      <summary>Menu <span aria-hidden="true">☰</span></summary>
      <div class="site-nav__menu-links">
        {links.map(({ href, label }) => <a href={href} aria-current={current === "store" && label === "Store" ? "page" : undefined}>{label}</a>)}
      </div>
    </details>
  </div>
</nav>
<script is:inline>document.querySelectorAll('.site-nav__menu-links a').forEach((link) => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')));</script>
<style is:global>
  body nav.site-nav { position: fixed; z-index: 50; inset: 0 0 auto; display: block; width: 100%; padding: 0; border-bottom: 1px solid rgba(217,155,74,.2); background: rgba(20,13,9,.8); backdrop-filter: blur(14px); }
  .site-nav__inner { width: 100%; max-width: 1100px; height: 66px; margin: auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .site-nav__brand { display: inline-flex; align-items: center; flex: 0 0 auto; height: 100%; }
  .site-nav__brand img { display: block; width: auto; height: 54px; max-width: 290px; object-fit: contain; }
  .site-nav__links { display: flex; gap: 28px; color: #bda98c; font: 400 .86rem/1.5 Inter,system-ui,sans-serif; }
  .site-nav__links a, .site-nav__menu-links a { color: inherit; text-decoration: none; }
  .site-nav__links a:hover, .site-nav__links a:focus-visible, .site-nav__links a[aria-current], .site-nav__menu-links a:hover { color: #f2e6ca; }
  .site-nav__menu { display: none; }
  @media (max-width: 700px) {
    .site-nav__inner { height: 58px; padding-inline: 16px; }
    .site-nav__brand img { height: 40px; max-width: min(170px,48vw); }
    .site-nav__links { display: none; }
    .site-nav__menu { display: block; flex: 0 0 auto; }
    .site-nav__menu summary { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 8px 12px; border: 1px solid rgba(242,230,202,.3); border-radius: 7px; color: #f2e6ca; font: 700 .85rem/1 Inter,system-ui,sans-serif; list-style: none; cursor: pointer; }
    .site-nav__menu summary::-webkit-details-marker { display: none; }
    .site-nav__menu summary:focus-visible { outline: 2px solid #d99b4a; outline-offset: 3px; }
    .site-nav__menu-links { position: absolute; top: 58px; left: 0; right: 0; display: grid; max-height: calc(100svh - 58px); overflow-y: auto; padding: 12px 16px 20px; border-bottom: 1px solid #624630; background: #1b120d; box-shadow: 0 22px 30px rgba(0,0,0,.45); color: #f2e6ca; }
    .site-nav__menu-links a { display: block; padding: 13px 10px; border-bottom: 1px solid rgba(242,230,202,.13); }
  }
</style>
