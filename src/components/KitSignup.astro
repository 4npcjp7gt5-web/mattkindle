---
interface Props {
  /** Numeric ID from Kit's Embed → HTML action URL (not the 10-character script UID). */
  formId: string;
  /** Existing Kit embed UID, kept on the form for native Kit attribution. */
  uid: string;
  variant?: "inline" | "modal";
}
const { formId, uid, variant = "inline" } = Astro.props;
if (!/^\d+$/.test(formId)) {
  throw new Error("KitSignup requires the numeric Kit form ID from Embed → HTML.");
}
const emailId = `email-signup-${variant}`;
---

<form
  class:list={["mk-signup", `mk-signup--${variant}`]}
  action={`https://app.kit.com/forms/${formId}/subscriptions`}
  method="post"
  data-sv-form={formId}
  data-uid={uid}
  data-format="inline"
  data-version="5"
>
  {variant === "inline" && (
    <div class="mk-signup__photo" aria-hidden="true">
      <img
        src="https://embed.filekitcdn.com/e/L5vABHJyxkxGyh1GoX8n5/gmCmyTq8fhvd2j84id3v2w"
        alt=""
        loading="lazy"
      />
      <span>Stay in the Loop</span>
    </div>
  )}
  <div class="mk-signup__fields">
    <label for={emailId}>Email address</label>
    <div class="mk-signup__entry">
      <input
        id={emailId}
        name="email_address"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        maxlength="254"
      />
      <button type="submit">Join</button>
    </div>
    <p class="mk-signup__note">
      Occasional music, video and show updates. Unsubscribe anytime.
    </p>
    <a
      class="mk-signup__kit-credit"
      href="https://kit.com/features/forms?utm_campaign=poweredby&amp;utm_content=form&amp;utm_medium=referral&amp;utm_source=dynamic"
      target="_blank"
      rel="noopener noreferrer"
    >Built with Kit</a>
  </div>
</form>

<style>
  .mk-signup {
    width: 100%;
    min-width: 0;
    display: grid;
    gap: 20px;
    margin: 0;
    color: #f2e6ca;
    background: transparent;
    font-family: Inter, system-ui, sans-serif;
  }
  .mk-signup__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    min-height: 160px;
    max-height: 260px;
    overflow: hidden;
    border-radius: 11px;
    background: #21150f;
  }
  .mk-signup__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(14, 9, 7, .74), rgba(14, 9, 7, .12));
  }
  .mk-signup__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }
  .mk-signup__photo span {
    position: absolute;
    inset: auto 10px 18px;
    z-index: 1;
    color: #f2e6ca;
    font: 700 clamp(1.65rem, 6vw, 2.7rem)/1 Oswald, Impact, sans-serif;
    letter-spacing: .085em;
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 2px 10px #120c08;
  }
  .mk-signup__fields { display: grid; gap: 12px; width: 100%; min-width: 0; }
  label { text-align: left; color: #d4bf9e; font-size: .9rem; font-weight: 600; }
  .mk-signup__entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
  input {
    width: 100%;
    min-width: 0;
    min-height: 50px;
    padding: 12px 15px;
    border: 1px solid rgba(217, 155, 74, .44);
    border-radius: 8px;
    color: #f2e6ca;
    background: #1b120d;
    font: inherit;
  }
  input::placeholder { color: #a99a89; opacity: 1; }
  input:focus-visible, button:focus-visible, a:focus-visible {
    outline: 2px solid #f2d49b;
    outline-offset: 3px;
  }
  button {
    min-height: 50px;
    padding: 12px 29px;
    border: 0;
    border-radius: 8px;
    background: #d99b4a;
    color: #1b120d;
    font: 700 .96rem/1 Inter, system-ui, sans-serif;
    letter-spacing: .07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .15s ease;
  }
  button:hover { background: #f0b363; }
  .mk-signup__note { margin: 0; color: #b7a695; font-size: .76rem; line-height: 1.55; }
  .mk-signup__kit-credit {
    justify-self: center;
    padding: 5px 8px;
    color: #b7a695;
    font: 600 .7rem/1.2 Inter, system-ui, sans-serif;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mk-signup--modal { gap: 8px; }
  .mk-signup--modal .mk-signup__fields { gap: 10px; }
  @media (max-width: 520px) {
    .mk-signup__photo { aspect-ratio: 1.65 / 1; max-height: 215px; }
    .mk-signup__entry { grid-template-columns: minmax(0, 1fr); }
    button { width: 100%; }
    .mk-signup__note { font-size: .72rem; }
  }
</style>
