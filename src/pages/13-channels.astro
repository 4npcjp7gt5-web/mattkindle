---
const songs = ["13 Channels","Don't Bury Me","Folklore","Over the Hill","The Spark","Fleetwood Mac","Your Medicine","Ghost","Fades Away","Home Run","Always Home","Nobody Sees Me","Deep Sinks","Shadows","Experiment #1","Fathers","Water St.","Chad"];
const services = [
{label:"Spotify",url:"https://open.spotify.com/artist/4kPWNGfm8xjSXSsZesTk7y",kind:"spotify"},
{label:"Apple Music",url:"https://music.apple.com/us/playlist/matts-songs/pl.u-55D66M3tEpB3q",kind:"apple"},
{label:"Amazon Music",url:"https://music.amazon.com/search/Matt+Kindle",kind:"amazon"},
{label:"YouTube",url:"https://www.youtube.com/@mattkindlemusic",kind:"youtube"}
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>13 Channels — Matt Kindle</title><meta name="description" content="Listen to 30-second previews of every song on Matt Kindle's 13 Channels."/><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=DM+Sans:wght@400;600;700&family=Special+Elite&display=swap" rel="stylesheet"/></head><body><main><nav><a href="/">← MATT KINDLE</a><span>THE LISTENING ROOM</span></nav><header><img class="cover" src="/images/13-channels-card-front.png" alt="Official 13 Channels album cover"/><div><p class="eyebrow">MATT KINDLE • THE ALBUM</p><h1><span>13</span><span>CHANNELS</span></h1><p class="tagline">A little static. A lot of stories.</p></div></header><section class="deck" aria-label="13 Channels music player"><div class="now"><img src="/images/13-channels-card-front.png" alt="" class="thumb"/><div class="nowtext"><p class="eyebrow">NOW PREVIEWING</p><h2 id="now-title">13 Channels</h2><input id="seek" type="range" min="0" max="30" value="0" step=".1" aria-label="Seek preview"/><div class="times"><span id="time">0:00</span><span>0:30</span></div></div></div><div class="controls"><button id="prev" aria-label="Previous track">◀◀</button><button id="toggle" class="big" aria-label="Play preview">▶</button><button id="next" aria-label="Next track">▶▶</button></div><div class="services">{services.map(s=><a class={s.kind} href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><a class="buy" href="https://kunaki.com/Sales.asp?PID=PX00S68AR3&amp;PP=1" target="_blank" rel="noopener noreferrer">Buy 13 Channels on CD ↗</a><p class="listtitle">CHOOSE A CHANNEL</p><div class="tracks">{songs.map((song,i)=><button class:list={["track",i===0&&"active"]} type="button" data-track={i} aria-label={`Play ${song}`}><span class="num">{String(i+1).padStart(2,"0")}</span><span class="trackicon">▶</span><span class="song">{song}</span><span class="wave" aria-hidden="true">{Array.from({length:30},(_,j)=><i style={`height:${4+Math.round(20*Math.abs(Math.sin((i+2)*4.1+j*1.73)*Math.cos(j*.19)))}px`}></i>)}</span><span class="duration">0:30</span></button>)}</div><p class="note">30-second song previews. Streaming buttons link to artist pages until album links are available.</p></section></main><audio id="audio" preload="none"></audio><script define:vars={{songs}}>const audio=document.querySelector('#audio'),seek=document.querySelector('#seek'),toggle=document.querySelector('#toggle'),rows=[...document.querySelectorAll('[data-track]')];let index=0;function update(){document.querySelector('#now-title').textContent=songs[index];rows.forEach((r,i)=>r.classList.toggle('active',i===index));toggle.textContent=audio.paused?'▶':'Ⅱ';toggle.setAttribute('aria-label',audio.paused?'Play preview':'Pause preview')}function select(i,play=true){index=(i+songs.length)%songs.length;audio.src='/audio/13-channels/'+String(index+1).padStart(2,'0')+'.mp3';seek.value=0;document.querySelector('#time').textContent='0:00';update();if(play)audio.play().catch(()=>{})}rows.forEach((r,i)=>r.addEventListener('click',()=>{if(index===i&&!audio.paused)audio.pause();else select(i)}));toggle.addEventListener('click',()=>audio.paused?audio.play().catch(()=>{}):audio.pause());document.querySelector('#prev').addEventListener('click',()=>select(index-1));document.querySelector('#next').addEventListener('click',()=>select(index+1));audio.addEventListener('play',update);audio.addEventListener('pause',update);audio.addEventListener('timeupdate',()=>{seek.value=Math.min(30,audio.currentTime);document.querySelector('#time').textContent='0:'+String(Math.min(30,Math.floor(audio.currentTime))).padStart(2,'0');if(audio.currentTime>=30)audio.pause()});seek.addEventListener('input',()=>audio.currentTime=Number(seek.value));select(0,false);</script></body></html>
<style is:global>
:root{--cream:#f3e5cd;--gold:#e0b982}*{box-sizing:border-box}body{margin:0;background:#120d0a;color:var(--cream);font-family:"DM Sans",sans-serif;background-image:radial-gradient(ellipse at 50% 0,#62402a70,transparent 65%),repeating-linear-gradient(90deg,#fff1 0 1px,transparent 1px 105px)}body:after{content:"";pointer-events:none;position:fixed;inset:0;opacity:.065;background:repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 4px)}main{max-width:1060px;margin:auto;padding:25px 14px 65px}nav{display:flex;justify-content:space-between;gap:10px;letter-spacing:.2em;font-size:11px;margin-bottom:32px;color:#d9bb97}nav a{color:inherit;text-decoration:none}header{display:grid;grid-template-columns:42% 1fr;gap:6%;align-items:center;margin-bottom:34px}.cover{width:100%;aspect-ratio:1.55;object-fit:cover;border:1px solid #a27c56;box-shadow:0 15px 55px #000b}.eyebrow{font-size:11px;color:var(--gold);letter-spacing:.28em}h1{font:900 clamp(70px,11vw,145px)/.75 "Barlow Condensed",Impact,sans-serif;margin:24px 0;letter-spacing:-.025em;text-shadow:3px 4px #52382a;position:relative}h1 span{display:block}h1:after{content:"";position:absolute;left:0;right:0;top:45%;height:12px;opacity:.5;background:repeating-linear-gradient(0deg,transparent 0 2px,#180f0a 2px 4px,transparent 4px 6px)}.tagline{font:18px "Special Elite",serif;color:#e7cba5}.deck{border:1px solid #886644;border-radius:18px;background:linear-gradient(130deg,#2a1e16f2,#15100df7);padding:clamp(16px,3vw,34px);box-shadow:0 18px 50px #0009}.now{display:grid;grid-template-columns:115px 1fr;gap:23px;align-items:center}.thumb{width:115px;height:115px;object-fit:cover;border:1px solid #a17c56}.nowtext{min-width:0}h2{font:600 clamp(25px,4vw,42px) Georgia,serif;margin:6px 0 13px}#seek{width:100%;accent-color:#eac89d}.times{display:flex;justify-content:space-between;color:#c2a98c;font-size:12px}.controls{display:flex;justify-content:center;align-items:center;gap:24px;margin:15px 0 24px}.controls button{border:0;background:transparent;color:var(--cream);cursor:pointer;font-size:20px;padding:10px}.controls .big{background:#f0d7b0;color:#20140d;border-radius:50%;width:67px;height:67px;font-size:27px}.services{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.services a{padding:13px 5px;border:1px solid #ad8866;border-radius:7px;color:var(--cream);text-align:center;text-decoration:none;font-size:13px;font-weight:700;background:#36271d}.services .spotify{border-color:#1db954}.services .apple{border-color:#e66a7a}.services .amazon{border-color:#7eaec8}.services .youtube{border-color:#db5555}.buy{display:block;text-align:center;color:var(--gold);margin:20px 0 25px;font-size:14px}.listtitle{border-top:1px solid #7a5a3d;padding-top:23px;letter-spacing:.25em;color:var(--gold);font-size:11px}.track{display:grid;grid-template-columns:28px 30px minmax(0,1fr) minmax(70px,28%) 38px;align-items:center;gap:10px;width:100%;padding:12px 9px;border:0;border-bottom:1px solid #574332;background:transparent;color:var(--cream);text-align:left;cursor:pointer;min-height:55px}.track.active{background:#80552b80;border-radius:6px}.track:hover{background:#80613d70}.num,.duration{color:#d3b58b;font-size:12px}.trackicon{display:grid;place-items:center;width:26px;height:26px;border:1px solid #d9b58a;border-radius:50%;font-size:11px}.song{font:16px Georgia,serif;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wave{height:25px;display:flex;align-items:center;gap:2px;overflow:hidden;opacity:.7}.wave i{display:block;background:#d0ac80;width:2px;min-width:2px}.note{font-size:11px;color:#bfa78c;margin-top:22px}@media(max-width:650px){header{grid-template-columns:1fr;gap:16px}.cover{max-height:250px}h1{font-size:clamp(76px,17vw,118px);margin:14px 0}.now{grid-template-columns:75px 1fr;gap:13px}.thumb{width:75px;height:75px}h2{font-size:25px}.services{grid-template-columns:repeat(2,1fr)}.track{grid-template-columns:23px 26px minmax(0,1fr) 37px;gap:7px}.wave{display:none}.song{font-size:15px}}button:focus-visible,a:focus-visible{outline:2px solid #f0d7b0;outline-offset:3px}
</style>