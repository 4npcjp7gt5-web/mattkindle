---
const playlists = {
  new: { label: "New Music", src: "https://embed.music.apple.com/us/playlist/matts-songs/pl.u-55D66M3tEpB3q?theme=dark", title: "Matt Kindle — New Music on Apple Music" },
  christian: { label: "Christian", src: "https://open.spotify.com/embed/playlist/6jPZiJcsgeP1e6gAvQrLnU?utm_source=generator&theme=0", title: "Matt Kindle — Christian Music on Spotify" },
  country: { label: "Country", src: "https://open.spotify.com/embed/playlist/1dMBFwdC6Zd3sqq3mg15jI?utm_source=generator&theme=0", title: "Matt Kindle — Country Music on Spotify" },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#1b120d" />
  <meta name="description" content="The official website of East Texas singer-songwriter Matt Kindle. Listen to new, Christian, and country music and find upcoming shows." />
  <meta property="og:title" content="Matt Kindle — Official Website" /><meta property="og:description" content="Songs about memory, faith, family, and the roads that lead us home." /><meta property="og:type" content="website" /><meta property="og:url" content="https://mattkindle.com/" /><meta property="og:image" content="https://mattkindle.com/images/hero-tv-room.jpg" />
  <link rel="icon" href="/favicon.ico" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  <title>Matt Kindle — Official Website</title>
</head>
<body>
  <nav class="nav" aria-label="Main navigation"><div class="nav__inner"><a class="wordmark" href="#top">Matt Kindle</a><div class="nav__links"><a href="#music">Music</a><a href="#shows">Shows</a><a href="#about">About</a><a href="#contact">Contact</a></div></div></nav>
  <header id="top" class="hero"><div class="scene"><img class="scene__room" src="/images/hero-tv-room.jpg" alt="A vintage television in an eighties bedroom, showing a grassy hill" /><div class="tv-screen" aria-hidden="true"><div class="walker"><span class="walker__shadow"></span><span class="walker__sprite"></span></div><div class="scanlines"></div></div><div class="vignette"></div></div><div class="hero__title"><p>New Music Coming October 23</p><h1 data-text="13 Channels">13 Channels</h1><span>Matt Kindle</span></div></header>
  <main>
    <section id="music" class="section"><p class="eyebrow">Turn the dial</p><h2 data-text="Music">Music</h2><p class="section__intro">New songs, songs of faith, and country stories—each with its own place on the dial.</p><div class="channel-tabs" role="tablist" aria-label="Music channels">{Object.entries(playlists).map(([id,item],index)=><button type="button" role="tab" id={`tab-${id}`} aria-selected={index===0?"true":"false"} aria-controls="player" data-channel={id}>{item.label}</button>)}</div><div id="player" class="player" role="tabpanel" aria-labelledby="tab-new"><iframe src={playlists.new.src} title={playlists.new.title} height="450" loading="lazy" allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"></iframe></div><div class="listen-links"><a href="https://open.spotify.com/artist/4kPWNGfm8xjSXSsZesTk7y" target="_blank" rel="noreferrer">Spotify ↗</a><a href="https://music.apple.com/us/playlist/matts-songs/pl.u-55D66M3tEpB3q" target="_blank" rel="noreferrer">Apple Music ↗</a><a href="https://www.youtube.com/@mattkindlemusic" target="_blank" rel="noreferrer">YouTube ↗</a></div></section>
    <section id="shows" class="section"><p class="eyebrow">Out in the world</p><h2 data-text="Shows">Shows</h2><div class="shows-card"><a class="bit-widget-initializer" data-artist-name="id_15630412" data-auto-style="false" data-background-color="transparent" data-text-color="#f2e6ca" data-separator-color="#6f513b" data-display-local-dates="true" data-display-past-dates="true" data-display-limit="all" data-app-id="695468e386442ab7aacc49b5c5ed6da8"></a></div></section>
    <section id="about" class="section about-section"><div><p class="eyebrow">Behind the songs</p><h2 data-text="About Matt">About Matt</h2></div><div class="about-copy"><p>Matt Kindle is an East Texas singer-songwriter making honest music rooted in melody, memory, faith, and the moments that linger.</p><p>His songs move between indie folk, Christian music, and country—different channels, but the same voice.</p></div></section>
    <section id="contact" class="section contact-section"><p class="eyebrow">Keep in touch</p><h2 data-text="Contact">Contact</h2><p>For music, shows, and everything in between.</p><div class="contact-links"><a href="mailto:mallets.prompts0z@icloud.com">Email</a><a href="https://www.instagram.com/matt_kindle/" target="_blank" rel="noreferrer">Instagram</a><a href="https://www.youtube.com/@mattkindlemusic" target="_blank" rel="noreferrer">YouTube</a></div></section>
  </main>
  <footer><span>Matt Kindle</span><small>© {new Date().getFullYear()} Matt Kindle</small></footer>
  <script is:inline define:vars={{playlists}}>document.querySelectorAll('[data-channel]').forEach((button)=>{button.addEventListener('click',()=>{const id=button.dataset.channel;const item=playlists[id];document.querySelectorAll('[data-channel]').forEach((tab)=>tab.setAttribute('aria-selected',String(tab===button)));const player=document.querySelector('#player');const frame=player.querySelector('iframe');player.setAttribute('aria-labelledby',`tab-${id}`);frame.src=item.src;frame.title=item.title;});});</script>
  <script async charset="utf-8" src="https://widgetv3.bandsintown.com/main.min.js"></script>
</body>
</html>
<style is:global>
:root{--walnut:#1b120d;--card:#322117;--cream:#f2e6ca;--muted:#bda98c;--amber:#d99b4a;--line:#624630}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--walnut)}body{margin:0;color:var(--cream);background:var(--walnut);font-family:Inter,system-ui,sans-serif;line-height:1.65;background-image:repeating-linear-gradient(90deg,rgba(255,255,255,.012) 0 1px,transparent 1px 110px),linear-gradient(180deg,#120c08,var(--walnut) 45rem)}a{color:inherit;text-decoration:none}.nav{position:fixed;z-index:50;top:0;left:0;width:100%;border-bottom:1px solid rgba(217,155,74,.2);background:rgba(20,13,9,.8);backdrop-filter:blur(14px)}.nav__inner{max-width:1100px;height:66px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between}.wordmark{font-family:"Playfair Display",serif;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:var(--amber)}.nav__links{display:flex;gap:28px;font-size:.86rem;color:var(--muted)}.nav a:hover,.nav a:focus-visible{color:var(--cream)}.hero{padding-top:66px;overflow:hidden}.scene{position:relative;width:100%;line-height:0}.scene__room{display:block;width:100%;height:auto}.tv-screen{position:absolute;left:25.3%;top:39.1%;width:40.6%;height:37%;overflow:hidden}.walker{position:absolute;left:40%;bottom:3%;height:36%;transform:translateX(-50%);animation:walk-up 22s cubic-bezier(.4,0,.6,1) infinite}.walker img{height:100%;width:auto;filter:saturate(.83) contrast(.94) brightness(.94);animation:bob .9s ease-in-out infinite}.scanlines{position:absolute;inset:0;background:repeating-linear-gradient(180deg,rgba(0,0,0,.28) 0 1px,transparent 1px 4px);animation:flicker 4s ease-in-out infinite}.vignette{position:absolute;inset:0;box-shadow:inset 0 0 190px rgba(10,6,3,.86);background:linear-gradient(0deg,var(--walnut),transparent 32%)}.hero__title{position:relative;z-index:2;margin-top:-8vw;padding:0 24px 68px;text-align:center}.hero__title p,.eyebrow{margin:0 0 10px;font-family:Audiowide,sans-serif;font-size:.66rem;letter-spacing:.48em;text-transform:uppercase;color:var(--amber)}.hero__title h1{margin:0;font-family:"Great Vibes",cursive;font-weight:400;font-size:clamp(4.4rem,10vw,9rem);line-height:1;color:#f7ecd6;text-shadow:0 8px 30px #080503}.hero__title span{display:block;margin-top:12px;font-family:"Playfair Display",serif;letter-spacing:.5em;text-transform:uppercase;color:#cdb487}.section{max-width:1050px;margin:auto;padding:96px 28px;scroll-margin-top:60px;border-top:1px solid rgba(98,70,48,.45)}h2{margin:0;font:600 clamp(2.7rem,6vw,4.5rem)/1 "Playfair Display",serif;color:var(--cream)}.section__intro{max-width:600px;margin:18px 0 32px;color:var(--muted);font-size:1.05rem}.channel-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:34px 0 20px}.channel-tabs button{border:1px solid var(--line);border-radius:999px;padding:11px 20px;background:transparent;color:var(--muted);font:600 .85rem Inter;cursor:pointer}.channel-tabs button[aria-selected="true"]{border-color:var(--amber);background:var(--amber);color:#1a100a;box-shadow:0 0 30px rgba(217,155,74,.2)}.player{padding:10px;border:1px solid var(--line);border-radius:18px;background:#130d09;box-shadow:0 24px 60px rgba(0,0,0,.28)}.player iframe{display:block;width:100%;border:0;border-radius:10px}.listen-links,.contact-links{display:flex;gap:24px;flex-wrap:wrap;margin-top:22px;color:var(--amber);font-weight:600}.shows-card{margin-top:35px;padding:28px;border:1px solid var(--line);border-radius:18px;background:rgba(50,33,23,.5)}.about-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.about-copy{color:var(--muted);font-family:"Playfair Display",serif;font-size:1.25rem}.about-copy p:first-child{margin-top:0}.contact-section{text-align:center}.contact-section .eyebrow{margin-left:.48em}.contact-section>p:not(.eyebrow){color:var(--muted)}.contact-links{justify-content:center}footer{max-width:1050px;margin:auto;padding:42px 28px 52px;border-top:1px solid rgba(98,70,48,.45);display:flex;justify-content:space-between;color:var(--muted)}footer span{font-family:"Playfair Display",serif;color:var(--amber)}
@keyframes walk-up{0%{left:40%;bottom:3%;height:36%;opacity:0}6%{opacity:1}92%{opacity:1}100%{left:56%;bottom:45%;height:11%;opacity:.82}}@keyframes bob{0%,100%{transform:translateY(0) rotate(-1.2deg)}50%{transform:translateY(-8%) rotate(1.2deg)}}@keyframes flicker{0%,100%{opacity:.1}47%{opacity:.18}52%{opacity:.05}}
@media(max-width:700px){.nav__inner{height:58px;padding:0 18px}.wordmark{font-size:.84rem}.nav__links{gap:13px;font-size:.72rem}.nav__links a:nth-child(3){display:none}.hero{padding-top:58px}.scene__room{width:150%;max-width:none;margin-left:-25%}.tv-screen{left:13%;top:39.1%;width:60.9%;height:37%}.hero__title{margin-top:-5vw;padding-bottom:55px}.hero__title p{font-size:.55rem}.hero__title span{font-size:.72rem}.section{padding:72px 20px}.about-section{grid-template-columns:1fr;gap:24px}.player iframe{height:420px}footer{padding:35px 20px;gap:18px;flex-direction:column;text-align:center}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.walker,.walker img,.scanlines{animation:none}}
</style>

<style is:global>
  /* Solid condensed block lettering, with the wear added separately like old ink on wood. */
  h1,
  h2,
  .hero__title p,
  .hero__title span,
  .eyebrow,
  .wordmark,
  footer span {
    font-family: "Oswald", "Arial Narrow", Impact, sans-serif !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
  }

  h1,
  h2 {
    position: relative;
    display: inline-block;
    line-height: .92 !important;
    letter-spacing: .075em !important;
    text-shadow: 0 2px 0 rgba(80, 47, 28, .5), 0 8px 28px rgba(0, 0, 0, .4);
  }

  h1::after,
  h2::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: 1;
    color: transparent;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse, rgba(25, 14, 9, .88) 0 .8px, transparent 1.35px),
      radial-gradient(circle, rgba(25, 14, 9, .62) 0 .55px, transparent 1.05px),
      repeating-linear-gradient(103deg, transparent 0 15px, rgba(25, 14, 9, .34) 15.5px 16.5px, transparent 17px 31px);
    background-size: 13px 17px, 19px 23px, 41px 47px;
    background-position: 2px 3px, 7px 11px, 0 0;
    -webkit-background-clip: text;
    background-clip: text;
  }

  h2 { font-size: clamp(3rem, 7vw, 5.8rem) !important; }

  .hero {
    position: relative !important;
    height: 100svh !important;
    min-height: 100svh !important;
    padding-top: 66px !important;
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    overflow: hidden !important;
  }

  .scene {
    flex: none !important;
    width: min(100%, calc(116.36svh - 77px)) !important;
  }

  .hero__title {
    position: absolute !important;
    z-index: 6 !important;
    inset-inline: 0 !important;
    bottom: clamp(18px, 3.5svh, 42px) !important;
    margin: 0 !important;
    padding: 70px 20px 0 !important;
    background: linear-gradient(transparent, rgba(24, 14, 9, .92) 56%) !important;
  }

  .hero__title h1 {
    font-size: clamp(3rem, 7.2vw, 6.7rem) !important;
  }

  .hero__title p {
    margin-bottom: 10px !important;
    font-size: clamp(.7rem, 1.2vw, .92rem) !important;
    letter-spacing: .2em !important;
  }

  .hero__title span {
    margin-top: 12px !important;
    font-size: clamp(.72rem, 1.15vw, .95rem) !important;
    letter-spacing: .24em !important;
  }

  .eyebrow {
    letter-spacing: .2em !important;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 100svh !important;
      padding-top: 58px !important;
    }

    .scene {
      width: 100% !important;
    }

    .scene__room {
      width: 100% !important;
      margin-left: 0 !important;
    }

    .tv-screen {
      left: 25.3% !important;
      top: 39.1% !important;
      width: 40.6% !important;
      height: 37% !important;
    }

    .hero__title {
      bottom: 22px !important;
      padding-top: 54px !important;
    }

    .hero__title h1 {
      font-size: clamp(2.55rem, 12vw, 3.8rem) !important;
    }

    .hero__title p {
      font-size: .63rem !important;
      letter-spacing: .12em !important;
    }

    .hero__title span {
      font-size: .68rem !important;
      letter-spacing: .2em !important;
    }

    h2 {
      font-size: clamp(3rem, 14vw, 4.8rem) !important;
    }
  }
</style>

<style is:global>
  /* Eight real gait phases replace the old sliding cutout. */
  .walker {
    left: 39%;
    bottom: 2%;
    height: 37%;
    aspect-ratio: 256 / 683;
    transform: translateX(-50%);
    filter: saturate(.72) contrast(.88) brightness(.88) sepia(.05);
    animation: realistic-walk-up 24s linear infinite;
  }

  .walker__sprite {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: url('/images/boy-walk-cycle.png') 0 0 / 800% 100% no-repeat;
    animation: walk-cycle .92s steps(7, end) infinite;
  }

  .walker__shadow {
    position: absolute;
    z-index: 1;
    left: 22%;
    right: 22%;
    bottom: -1%;
    height: 4%;
    border-radius: 50%;
    background: rgba(24, 31, 14, .38);
    filter: blur(2px);
  }

  .scanlines { z-index: 4; }

  @keyframes realistic-walk-up {
    0% { left: 39%; bottom: 2%; height: 37%; opacity: 0; }
    5% { opacity: .95; }
    35% { left: 43%; bottom: 15%; height: 29%; }
    68% { left: 49%; bottom: 31%; height: 20%; }
    93% { opacity: .9; }
    100% { left: 55%; bottom: 47%; height: 11%; opacity: 0; }
  }

  @keyframes walk-cycle {
    from { background-position: 0 0; }
    to { background-position: 100% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .walker__sprite { animation: none; }
  }
</style>
