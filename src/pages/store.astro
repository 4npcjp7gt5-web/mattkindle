<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#1b120d" />
  <meta name="description" content="Shop Matt Kindle shirts, hats, and the upcoming 13 Channels CD." />
  <title>Store | Matt Kindle</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <nav aria-label="Main navigation"><div class="nav-inner"><a class="brand" href="/">Matt Kindle</a><div class="nav-links"><a href="/#music">Music</a><a href="/store/" aria-current="page">Store</a><a href="/#shows">Shows</a><a href="/#contact">Contact</a></div></div></nav>
  <main>
    <header><p class="eyebrow">Matt Kindle / 13 Channels</p><h1>Store</h1><p class="lead">Bring a little of the music home. Shop the shirts and hats now; the 13 Channels CD arrives October 23.</p></header>
    <div class="products">
      <article class="product"><div class="product-image"><img src="/images/13-channels-store-cover.jpg" alt="13 Channels album artwork: a vintage TV showing a boy facing a grassy hill" /></div><div class="product-copy"><p class="eyebrow">Physical album</p><h2>13 Channels on CD</h2><p>The album in a jewel case. Orders open October 23; Kunaki will make and ship each CD.</p><span class="button unavailable" aria-disabled="true">Coming October 23</span></div></article>

    </div>
    <section class="merch-section" aria-labelledby="merch-heading">
      <div class="merch-heading"><div><p class="eyebrow">Made to order · Fourthwall</p><h2 id="merch-heading">Wear the music</h2><p>Every shirt, hat, and hoodie in the Matt Kindle shop.</p></div><a class="shop-all" href="https://matt-kindle-shop.fourthwall.com/collections/all" rel="noopener noreferrer" target="_blank">Browse all on Fourthwall ↗</a></div>
      <div class="merch-grid">
        {merch.map((item) => <a class="merch-card" href={item.url} rel="noopener noreferrer" target="_blank" aria-label={`${item.name}, ${item.price}. Shop on Fourthwall`}>
          <div class="merch-photo"><img src={item.image} alt={item.name} loading="lazy" decoding="async" /></div>
          <div class="merch-detail"><span class="merch-kind">{item.kind}</span><h3>{item.name}</h3><div class="merch-bottom"><span class="merch-price">{item.price}</span><span class="merch-action">Shop now ↗</span></div></div>
        </a>)}
      </div>
    </section>
    <p class="note">CDs and merch have separate checkouts and may arrive in separate shipments. Shipping costs are shown at checkout.</p>
  </main>
  <footer><a href="/">← Back to music</a><span>© {new Date().getFullYear()} Matt Kindle</span></footer>
</body>
</html>
<style>
:root{--bg:#1b120d;--cream:#f2e6ca;--muted:#bda98c;--amber:#d99b4a;--line:#624630}*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;color:var(--cream);background:linear-gradient(#120c08,var(--bg) 32rem);font:16px/1.6 Inter,system-ui,sans-serif}a{color:inherit;text-decoration:none}nav{border-bottom:1px solid var(--line);background:#160e0a}.nav-inner{max-width:1100px;min-height:66px;padding:12px 28px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand,h1,h2,.eyebrow{font-family:Oswald,Impact,sans-serif;text-transform:uppercase}.brand{font-size:1.15rem;letter-spacing:.14em;color:var(--amber)}.nav-links{display:flex;gap:24px;flex-wrap:wrap;color:var(--muted);font-size:.9rem}.nav-links a:hover,.nav-links a[aria-current]{color:var(--cream)}main{max-width:1100px;padding:55px 28px 90px;margin:auto}header{max-width:730px;margin-bottom:42px}.eyebrow{color:var(--amber);letter-spacing:.2em;font-size:.88rem;margin:0 0 12px}h1{font-size:clamp(4rem,10vw,8rem);letter-spacing:.07em;line-height:.95;margin:0}h2{font-size:clamp(2rem,4vw,3rem);letter-spacing:.045em;line-height:1.1;margin:0 0 18px}.lead{font-size:1.15rem;color:var(--muted);max-width:540px}.products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.product{overflow:hidden;border:1px solid var(--line);background:#2b1d15;border-radius:12px}.product-image{aspect-ratio:1.5;overflow:hidden;background:#120b08;display:flex;align-items:center;justify-content:center}.product-image img{width:100%;height:100%;object-fit:cover}.product-copy{padding:30px}.product-copy p:not(.eyebrow){color:var(--muted);min-height:3.2em}.merch .product-image{background:radial-gradient(circle at center,#62412b,#1b120d 72%);color:#efdbb9}.merch .product-image>span{font:700 clamp(5rem,12vw,10rem)/1 Oswald;letter-spacing:-.08em;text-shadow:0 8px 20px #100905}.merch .small{display:block;text-align:center;font:600 .85rem Inter;letter-spacing:.4em;text-transform:uppercase}.shirt-links{display:flex;flex-wrap:wrap;gap:10px}.shirt-links .button{margin-top:0;font-size:.9rem}.shop-all{display:inline-block;margin-top:18px;color:var(--amber);font-weight:600;text-decoration:underline;text-underline-offset:4px}.button{display:inline-block;padding:12px 22px;margin-top:10px;border-radius:3px;background:var(--amber);color:#211309;font-weight:700}.button:hover{background:#f1bb73}.button.unavailable{background:#584636;color:#e0ceb4;cursor:default}.note{margin:30px 0 0;color:var(--muted);font-size:.9rem}footer{border-top:1px solid var(--line);max-width:1100px;margin:auto;padding:28px;display:flex;justify-content:space-between;gap:20px;color:var(--muted)}footer a:hover{color:var(--cream)}@media(max-width:700px){.nav-inner{padding:12px 18px}.nav-links{gap:12px;font-size:.8rem}.nav-links a:first-child,.nav-links a:last-child{display:none}main{padding:40px 18px 65px}.products{grid-template-columns:1fr}.product-copy p:not(.eyebrow){min-height:0}footer{padding:25px 18px;flex-direction:column}}
.products{grid-template-columns:1fr}.products .product{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}.products .product-image{aspect-ratio:1.5}.products .product-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.products .product-copy p:not(.eyebrow){min-height:0}.merch-section{margin-top:72px}.merch-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:27px}.merch-heading h2{margin:0}.merch-heading p:not(.eyebrow){margin:12px 0 0;color:var(--muted)}.merch-heading .shop-all{white-space:nowrap}.merch-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.merch-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:#2b1d15;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.merch-card:hover,.merch-card:focus-visible{transform:translateY(-4px);border-color:var(--amber);box-shadow:0 16px 34px rgba(0,0,0,.3)}.merch-photo{aspect-ratio:1.08;background:#30251d;overflow:hidden}.merch-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .3s ease}.merch-card:hover .merch-photo img{transform:scale(1.035)}.merch-detail{display:flex;flex:1;flex-direction:column;padding:19px 20px 21px}.merch-kind{color:var(--amber);font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.merch-detail h3{margin:8px 0 20px;font:600 1.4rem/1.22 Oswald,Impact,sans-serif;text-transform:uppercase;letter-spacing:.025em}.merch-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto}.merch-price{font-weight:700}.merch-action{color:var(--amber);font-size:.85rem;font-weight:700;white-space:nowrap}@media(max-width:850px){.merch-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.products .product{grid-template-columns:1fr}.merch-section{margin-top:54px}.merch-heading{display:block}.merch-heading .shop-all{margin-top:13px}}@media(max-width:520px){.merch-grid{gap:12px}.merch-detail{padding:14px}.merch-detail h3{font-size:1.06rem}.merch-bottom{display:block}.merch-action{display:block;margin-top:6px}.merch-photo{aspect-ratio:1}}@media(prefers-reduced-motion:reduce){.merch-card,.merch-photo img{transition:none}}
</style>
