---
const spotify = "https://open.spotify.com/track/5iBGF0h5J0T3JVB3q5HFHG?si=n4Gt9h-eTtG7rN50brcUkw&utm_source=copy-link";
const apple = "https://music.apple.com/us/album/ghost-single/6809943132";
const youtube = "https://youtu.be/BSAe7W8Hyvg?is=Y9HDigE6u3Tsvrj2";
const amazon = "https://music.amazon.com/albums/B0HJ6S8WZJ?do=play&trackAsin=B0HJ6TZP57&ts=1788906960&ref=dm_sh_UhjcTUSXwvVP13d9tQKkXp2Ab";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ghost — Matt Kindle</title>
  <meta name="description" content="Listen to Ghost, the new single from Matt Kindle. Streaming now on Spotify, Apple Music, and YouTube." />
  <link rel="canonical" href="https://mattkindle.com/ghost" />

  <meta property="og:type" content="music.song" />
  <meta property="og:title" content="Ghost — Matt Kindle" />
  <meta property="og:description" content="The new single from Matt Kindle. Listen now." />
  <meta property="og:url" content="https://mattkindle.com/ghost" />
  <meta property="og:image" content="https://mattkindle.com/ghost-cover.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Ghost — Matt Kindle" />
  <meta name="twitter:description" content="The new single from Matt Kindle. Listen now." />
  <meta name="twitter:image" content="https://mattkindle.com/ghost-cover.png" />

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');

    :root {
      --ink: #11120f;
      --ink2: #1b1b17;
      --bone: #d9c4a3;
      --bone2: #bba17d;
      --dust: #8e785c;
      --line: rgba(217,196,163,.24);
      --glass: rgba(17,18,15,.72);
      --glass2: rgba(24,24,20,.82);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--bone);
      background: #0d0e0c;
      font-family: "DM Sans", system-ui, sans-serif;
      overflow-x: hidden;
    }

    .bg {
      position: fixed;
      inset: -4%;
      z-index: -3;
      background-image:
        linear-gradient(rgba(7,8,7,.54), rgba(7,8,7,.84)),
        url("/ghost-cover.png");
      background-size: cover;
      background-position: center;
      filter: blur(18px) saturate(.65) contrast(1.05);
      transform: scale(1.08);
    }

    .vignette {
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 38%, transparent 0 22%, rgba(7,7,6,.32) 58%, rgba(5,5,4,.88) 100%),
        linear-gradient(180deg, rgba(18,18,15,.04), rgba(7,7,6,.6));
    }

    .grain {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 20;
      opacity: .18;
      background-image:
        repeating-radial-gradient(circle at 17% 23%, rgba(255,255,255,.14) 0 1px, transparent 1px 3px);
      background-size: 6px 6px;
      mix-blend-mode: soft-light;
    }

    .frame {
      position: fixed;
      inset: 9px;
      pointer-events: none;
      z-index: 19;
      border: 1px solid rgba(217,196,163,.16);
      box-shadow:
        inset 0 0 28px rgba(217,196,163,.035),
        0 0 0 1px rgba(0,0,0,.38);
    }

    .shell {
      width: min(1180px, calc(100% - 36px));
      min-height: 100svh;
      margin: 0 auto;
      display: grid;
      grid-template-rows: auto 1fr auto;
      padding: 24px 0 24px;
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 4px 2px 26px;
      position: relative;
      z-index: 4;
    }

    .brand, .album {
      color: var(--bone);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .22em;
      font-size: 11px;
      font-weight: 600;
    }

    .album {
      color: rgba(217,196,163,.64);
      letter-spacing: .16em;
    }

    .album:hover, .brand:hover { color: #f1dfc1; }

    main {
      display: grid;
      grid-template-columns: minmax(300px, 540px) minmax(300px, 1fr);
      align-items: center;
      gap: clamp(42px, 7vw, 92px);
      padding: 22px 2px 46px;
    }

    .art-stage {
      position: relative;
      width: 100%;
      max-width: 540px;
      justify-self: end;
    }

    .art-glow {
      position: absolute;
      inset: 9% -8% -12%;
      background: radial-gradient(circle, rgba(196,165,124,.22), transparent 66%);
      filter: blur(44px);
      opacity: .68;
    }

    .art-shell {
      position: relative;
      padding: 8px;
      background: rgba(17,18,15,.76);
      border: 1px solid rgba(217,196,163,.23);
      box-shadow: 0 34px 90px rgba(0,0,0,.66);
      transform: rotate(-.35deg);
    }

    .cover {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border: 1px solid rgba(217,196,163,.13);
    }

    .copy {
      max-width: 500px;
      position: relative;
      z-index: 3;
    }

    .eyebrow {
      margin: 0 0 17px;
      text-transform: uppercase;
      letter-spacing: .26em;
      font-size: 10px;
      font-weight: 700;
      color: rgba(217,196,163,.64);
    }

    h1 {
      margin: 0 0 13px;
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(74px, 10vw, 138px);
      line-height: .76;
      letter-spacing: .22em;
      font-weight: 500;
      text-transform: uppercase;
      color: #dfc8a7;
      text-shadow: 0 8px 32px rgba(0,0,0,.42);
    }

    .artist {
      margin: 0 0 25px;
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(20px, 2vw, 26px);
      text-transform: uppercase;
      letter-spacing: .3em;
      color: rgba(217,196,163,.85);
    }

    .rule {
      width: 72px;
      height: 1px;
      background: linear-gradient(90deg, var(--bone2), transparent);
      opacity: .7;
      margin: 0 0 23px;
    }

    .sub {
      margin: 0 0 30px;
      max-width: 430px;
      color: rgba(217,196,163,.72);
      line-height: 1.7;
      font-size: 14px;
    }

    .listen-label {
      margin: 0 0 11px;
      text-transform: uppercase;
      letter-spacing: .22em;
      font-size: 10px;
      font-weight: 700;
      color: rgba(217,196,163,.46);
    }

    .buttons {
      width: min(100%, 440px);
      display: grid;
      gap: 10px;
    }

    .listen {
      position: relative;
      isolation: isolate;
      min-height: 62px;
      padding: 0 19px 0 21px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #ead8bb;
      text-decoration: none;
      border: 1px solid var(--line);
      background: var(--glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      overflow: hidden;
      transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

    .listen::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0;
      background: linear-gradient(90deg, rgba(187,161,125,.13), transparent 65%);
      transition: opacity .18s ease;
    }

    .listen:hover {
      transform: translateY(-2px);
      background: var(--glass2);
      border-color: rgba(217,196,163,.48);
    }

    .listen:hover::before { opacity: 1; }

    .service {
      display: flex;
      align-items: center;
      gap: 14px;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: .02em;
    }

    .icon {
      width: 21px;
      height: 21px;
      display: grid;
      place-items: center;
      opacity: .92;
    }

    .icon svg { width: 100%; height: 100%; fill: currentColor; }

    .amazon-mark { font-family: Arial, sans-serif; font-size: 24px; font-weight: 700; line-height: 1; }

    .arrow {
      font-size: 17px;
      color: rgba(217,196,163,.4);
      transition: transform .18s ease, color .18s ease;
    }

    .listen:hover .arrow {
      color: var(--bone);
      transform: translateX(3px);
    }

    .album-note {
      margin-top: 28px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      color: rgba(217,196,163,.44);
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .moon {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: 1px solid rgba(217,196,163,.55);
      box-shadow: inset 2px 0 0 #0d0e0c;
    }

    footer {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding-top: 19px;
      border-top: 1px solid rgba(217,196,163,.10);
      color: rgba(217,196,163,.35);
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    footer a { color: inherit; text-decoration: none; }
    footer a:hover { color: rgba(217,196,163,.7); }

    @media (max-width: 800px) {
      .shell {
        width: min(100% - 28px, 590px);
        padding-top: 18px;
      }

      nav { padding-bottom: 14px; }

      main {
        grid-template-columns: 1fr;
        gap: 34px;
        padding-top: 10px;
      }

      .art-stage {
        justify-self: center;
        max-width: 470px;
      }

      .copy { max-width: 100%; }

      h1 {
        font-size: clamp(64px, 22vw, 102px);
        letter-spacing: .13em;
      }

      .artist { letter-spacing: .23em; }

      .buttons { width: 100%; }

      footer {
        margin-top: 16px;
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
      }

      .bg { filter: blur(16px) saturate(.58); }
    }

    @media (max-width: 420px) {
      .album { display: none; }
      h1 { font-size: clamp(58px, 21vw, 84px); }
      .art-shell { padding: 6px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .listen, .arrow, .listen::before { transition: none; }
    }
  </style>
</head>

<body>
  <div class="bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"></div>

  <div class="shell">
    <nav>
      <a class="brand" href="/">Matt Kindle</a>
      <a class="album" href="/">13 Channels · October 23</a>
    </nav>

    <main>
      <div class="art-stage">
        <div class="art-glow" aria-hidden="true"></div>
        <div class="art-shell">
          <img class="cover" src="/ghost-cover.png" alt="Ghost single artwork by Matt Kindle" />
        </div>
      </div>

      <section class="copy" aria-labelledby="ghost-title">
        <p class="eyebrow">New single · out now</p>
        <h1 id="ghost-title">Ghost</h1>
        <p class="artist">Matt Kindle</p>
        <div class="rule" aria-hidden="true"></div>

        <p class="sub">
          The first single from <em>13 Channels</em>. Listen now on your platform of choice.
        </p>

        <p class="listen-label">Listen</p>

        <div class="buttons">
          <a class="listen" href={spotify} target="_blank" rel="noopener noreferrer">
            <span class="service">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 1.8A10.2 10.2 0 1 0 12 22.2 10.2 10.2 0 0 0 12 1.8Zm4.68 14.7a.64.64 0 0 1-.88.21c-2.42-1.48-5.47-1.81-9.06-.99a.64.64 0 1 1-.29-1.25c3.92-.9 7.29-.52 10.02 1.14.3.18.4.58.21.89Zm1.26-2.8a.8.8 0 0 1-1.1.26c-2.77-1.7-6.99-2.19-10.27-1.2a.8.8 0 1 1-.46-1.53c3.75-1.13 8.4-.58 11.57 1.37.38.23.5.72.26 1.1Zm.11-2.91C14.73 8.82 9.25 8.63 6.08 9.58a.96.96 0 1 1-.56-1.84c3.65-1.11 9.7-.88 13.51 1.38a.96.96 0 0 1-.98 1.67Z"/></svg>
              </span>
              Spotify
            </span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a class="listen" href={apple} target="_blank" rel="noopener noreferrer">
            <span class="service">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M18.7 13.1c0-3.3 2.7-4.9 2.8-5-1.5-2.2-3.9-2.5-4.7-2.6-2-.2-3.9 1.2-4.9 1.2-1 0-2.6-1.2-4.3-1.1-2.2 0-4.2 1.3-5.3 3.2-2.3 4-.6 9.8 1.6 13 .99 1.55 2.27 3.26 3.9 3.2 1.57-.06 2.16-1.02 4.06-1.02 1.9 0 2.43 1.02 4.1.99 1.7-.03 2.76-1.53 3.74-3.1 1.23-1.8 1.74-3.54 1.77-3.63-.04-.02-2.77-1.06-2.77-4.14ZM15.5 3.42A4.55 4.55 0 0 0 16.58.16a4.65 4.65 0 0 0-3.05 1.56 4.32 4.32 0 0 0-1.1 3.14c1.14.09 2.3-.58 3.07-1.44Z"/></svg>
              </span>
              Apple Music
            </span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a class="listen" href={youtube} target="_blank" rel="noopener noreferrer">
            <span class="service">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
              </span>
              YouTube
            </span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a class="listen" href={amazon} target="_blank" rel="noopener noreferrer">
            <span class="service">
              <span class="icon amazon-mark" aria-hidden="true">a</span>
              Amazon Music
            </span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="album-note">
          <span class="moon" aria-hidden="true"></span>
          <span>Alternative Folk</span>
          <span>•</span>
          <span>From 13 Channels</span>
        </div>
      </section>
    </main>

    <footer>
      <span>© 2026 Matt Kindle</span>
      <a href="/">mattkindle.com</a>
    </footer>
  </div>
</body>
</html>
